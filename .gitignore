# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.iml
# Scratch query files an editor leaves behind.
*.sql
# Migrations carry the schema's history, so they are tracked.
!supabase/migrations/*.sql

# Secrets and local tooling state — never commit
.env
.env.*
!.env.example
.intelligence/
INTELLIGENCE.md
.fleet/
.junie/
*.pem
*.p12
*.pfx
id_rsa
id_ed25519

# Vercel CLI link state (project/org ids) is per-machine.
.vercel/*
# The project link is the repository saying where it deploys, and it carries
# no credential: project and team id only.
!.vercel/project.json

# Windows folder metadata
desktop.ini
.vercel

# Supabase CLI scratch
supabase/.temp/
